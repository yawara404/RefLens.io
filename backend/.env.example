# ============================================
# RefLens.io Backend Environment Variables
# backend/.env にコピーして使ってください（cp .env.example .env）
# ============================================

# ---------- AI プロバイダ（構図・光・衣装の解析） ----------
# ollama / gemini / heuristic を指定。空欄なら自動選択（ollama → gemini → heuristic）
LLM_PROVIDER=ollama

# ---------- Ollama（ローカル LLM） ----------
# 既定は gemma3:4b。gemma3 は画像（vision）に対応しているので解析もそのまま行える
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=4096
# ローカル推論は cold start を含めて時間がかかるため長めに取る
OLLAMA_TIMEOUT=180

# ---------- Gemini Vision（LLM_PROVIDER=gemini のときだけ使う） ----------
# 空欄でも heuristic 解析（画像特徴量ベース）で動作します
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Database ----------
# 開発時は既定の SQLite を使うため省略可
# DATABASE_URL=sqlite:///./reflens.db
# MySQL 8.x の例:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/reflens_db?charset=utf8mb4

# ---------- Pixiv 非公式 App API（ローカル利用専用） ----------
# Pixiv Developersでのアプリ登録では取得できません。PIXIV_SETUP.md を参照。
# 値はサーバーにのみ置き、フロントエンドやGitには含めないでください。
PIXIV_CLIENT_ID=
PIXIV_CLIENT_SECRET=
# backend/venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# 既存DBのトークンを読めなくなるため、生成後は変更しないでください。
PIXIV_TOKEN_ENCRYPTION_KEY=

# 任意: i.pximg.net の代替ホスト（imirror 等）
# PIXIV_IMAGE_HOST=i.pximg.net

# ---------- Instagram ----------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# ---------- Security ----------
# 必ず独自の長い値にすること。空のままだとバックエンドがランダムな鍵を生成し、
# 再起動のたびに発行済みトークンが無効になる。
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
